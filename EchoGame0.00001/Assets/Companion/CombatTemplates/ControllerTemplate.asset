  m_Script: {fileID: 11500000, guid: 7f3a9c21e5b84d6e9a0c1f27b3d84e60, type: 3}
  m_Name: ControllerTemplate
  m_EditorClassIdentifier: Assembly-CSharp::CombatProfileTemplate
  role: 3
  summary: 'Controller archetype. Holds mid-range and shapes the fight rather than
    winning the trade. Intercept OFF. High weight on SWINGING enemies - a debuff landing
    mid-swing amplifies the hit that is already committed. LOW weight on wounded:
    a dying enemy does not need a debuff spent on it, that swing belongs to the damage
    role. Moderate self-preserve, since dropping takes the party buffs down too.'
  senseRadius: 14
  disengageRadius: 17
  engageRadius: 8
  leashRadius: 9
  leashResumeRadius: 7
  targetLeashSlack: 2.5
  scanInterval: 0.15
  reactionDelay: 0.15
