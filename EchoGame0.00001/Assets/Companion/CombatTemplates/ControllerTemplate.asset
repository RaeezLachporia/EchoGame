  anchorFanSign: 0
  anchorForwardBias: 1
  moveSpeed: 4.5
  moveAnimSpeed: 6
  rotationSpeed: 10
  selfPreserveEnter: 0.4
  selfPreserveExit: 0.65
  selfPreserveRadius: 7
  interceptEnabled: 0
  interceptTriggerRange: 6
  blockPadding: 0.3
  minPlayerClearance: 1
  fallbackEnemyReach: 2.3
  disengageLinger: 1.2
  reEngageCooldown: 0.5
  weightTargetsMe: 1
  weightTargetsAlly: 1.8
  weightSwinging: 1.2
  weightWounded: 0.5
  weightDistance: 1.3
