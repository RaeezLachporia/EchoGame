  m_Name: DamageTemplate
  m_EditorClassIdentifier: Assembly-CSharp::CombatProfileTemplate
  role: 1
  summary: 'Damage archetype. Chases the priority target and finishes wounded enemies.
    Intercept OFF - stepping in front of a swing is the tank job, not this one. Large
    sense and engage radii so a damage role ranges off the party toward whatever is
    worth killing. High self-preserve threshold: fragile, so bail early and let the
    tank re-establish.'
  senseRadius: 16
  disengageRadius: 20
  engageRadius: 12
  leashRadius: 12
  leashResumeRadius: 9
  targetLeashSlack: 3
  scanInterval: 0.15
  reactionDelay: 0.15
  anchorDistance: 3.5
  anchorFanAngle: 0
  anchorFanSign: 0
  moveSpeed: 4.5
  moveAnimSpeed: 6
  rotationSpeed: 10
  selfPreserveEnter: 0.45
  selfPreserveExit: 0.65
  selfPreserveRadius: 6
  interceptEnabled: 0
  interceptTriggerRange: 6
  blockPadding: 0.3
  minPlayerClearance: 1
  fallbackEnemyReach: 2.3
  disengageLinger: 1.2
  reEngageCooldown: 0.5
  weightTargetsMe: 1.5
  weightTargetsAlly: 2
  weightSwinging: 1
  weightWounded: 1.5
  weightDistance: 1.5
