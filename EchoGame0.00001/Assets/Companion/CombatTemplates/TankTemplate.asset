  m_Name: TankTemplate
  m_EditorClassIdentifier: Assembly-CSharp::CombatProfileTemplate
  role: 0
  summary: 'Tank archetype. Holds the front line and soaks what would otherwise reach
    the party. Intercept ON - body-blocking is the whole job. Low self-preserve threshold:
    eating damage down past a third is the point, not a mistake. Short leash and a
    modest engage radius keep a tank a wall rather than a chaser.'
  senseRadius: 14
  disengageRadius: 18
  engageRadius: 8
  leashRadius: 10
  leashResumeRadius: 7
  targetLeashSlack: 3
  scanInterval: 0.15
  reactionDelay: 0.15
  anchorDistance: 2.75
  anchorFanAngle: 0
  anchorFanSign: 0
  anchorForwardBias: 1
  moveSpeed: 4.5
  moveAnimSpeed: 6
  rotationSpeed: 10
  selfPreserveEnter: 0.3
  selfPreserveExit: 0.45
  selfPreserveRadius: 6
  interceptEnabled: 1
  interceptTriggerRange: 6
  blockPadding: 0.3
  minPlayerClearance: 1
  fallbackEnemyReach: 2.3
  disengageLinger: 1.2
  reEngageCooldown: 0.5
  weightTargetsMe: 1.5
  weightTargetsAlly: 2
  weightSwinging: 1
  weightWounded: 1.2
  weightDistance: 1.5
